# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key is used only in server-side API routes, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tv-signage
# Public URL base for the bucket (r2.dev dev domain or your own custom domain connected to the bucket)
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Simple shared password for the /admin area (see middleware.ts)
ADMIN_PASSWORD=change-me
